# Sentinel — docker-compose credentials.
#
#   cp .env.example .env      # then replace every placeholder with a strong, unique value
#
# .env is git-ignored and docker-ignored: it must never be committed or baked
# into an image. docker-compose.yml reads it for the ${VAR:?...} substitutions
# and refuses to start while any of the required values below is missing.

# --- Orthanc PACS REST user -------------------------------------------------
# Registered on the orthanc service (ORTHANC__REGISTERED_USERS) and used by the
# watcher + inference server for HTTP basic auth against http://orthanc:8042.
ORTHANC_USER=sentinel
ORTHANC_PASSWORD=change-me-orthanc-rest-password

# --- Sentinel service account (watcher -> inference server) -----------------
# A Sentinel user with the radiologist or admin role. The watcher logs in with
# it to submit PACS studies to POST /analyze/study (the server runs with auth ON).
# Create it as an admin: desktop app (Admin -> Users) or POST /auth/register.
SENTINEL_SERVICE_USER=pacs-watcher
SENTINEL_SERVICE_PASSWORD=change-me-service-account-password

# --- Optional --------------------------------------------------------------
# Reserved. docker-compose passes it to the inference + watcher services, but
# the current backend does not read it (the SQLite DB is not encrypted at rest
# yet - rely on disk encryption + the 0600/0700 file modes). Leave empty.
SENTINEL_DB_KEY=

# Persisted analyzed-slice previews (DATA_DIR/previews/<study_id>.png) are
# deleted at startup once older than this many days. Default 365.
SENTINEL_PREVIEW_RETENTION_DAYS=365
